meta {
  name: Remove a place action link
  type: http
  seq: 15
}

delete {
  url: {{baseUrl}}/v1/accounts/:id/gbp/place-actions/:linkId
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
  linkId: {{linkId}}
}

