meta {
  name: Update a webhook
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/v1/webhooks/:id
  body: json
  auth: inherit
}

params:path {
  id: {{webhookId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Example name",
    "url": "https://example.com",
    "active": false,
    "secret": "xxxxxxxxxxxxxxxx"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Re-enabling a webhook (`active: true`) resets its failure count.

  Requires the `webhooks` scope when using an API key.

  Requires an active subscription; without one the request fails with 403 `subscription_required`.

  **Scope:** `webhooks`

  **Optional fields** (not in the example body):
  - `name`: string | null
  - `url`: string (uri)
  - `events`: `post.scheduled` | `post.published` | `post.partially_failed` | `post.failed` | `post.deleted` | `delivery.published` | `delivery.failed` | `delivery.delayed` | `account.connected` | `account.disconnected` | `account.health_changed` | `inbox.comment_received` | `inbox.mention_received` | `inbox.message_received` | `automation.triggered` | `automation.completed` | `automation.failed`[]
  - `active`: boolean
  - `secret`: string — Rotates the signing secret; the new value is returned once in this response.
  - `headers`: object | null — Replaces the header set. A null value keeps the stored value of an existing header; a top-level null clears every header.
}
