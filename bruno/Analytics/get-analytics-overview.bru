meta {
  name: Get analytics overview
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/analytics/overview
  body: none
  auth: inherit
}

params:query {
  ~account_id: 
  ~workspace_id: 
  ~days: 7
  ~from: 
  ~to: 
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Cross-workspace dashboard totals, period deltas, today’s stats, and a per-account breakdown with follower history. Use either `days` or an explicit `from`/`to` range.

  Requires the `analytics` scope when using an API key.

  **Scope:** `analytics`
}
