meta {
  name: Get inbox analytics per conversation
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/v1/analytics/inbox/conversations
  body: none
  auth: inherit
}

params:query {
  ~accountId: 
  ~workspace_id: 
  ~days: 7
  ~sort: volume
  ~page: 1
  ~per_page: 25
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  The same inbox numbers broken out per thread: what each one carried and how long it waited for a reply. Aggregates only — no message text and no author.

  Requires the `analytics` scope when using an API key.

  **Scope:** `analytics`
}
