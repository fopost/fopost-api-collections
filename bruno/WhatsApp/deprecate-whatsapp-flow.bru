meta {
  name: Deprecate a WhatsApp flow
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/v1/accounts/:id/whatsapp/flows/:flowId/deprecate
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Retires a published flow. This cannot be undone.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
