meta {
  name: List WhatsApp groups
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/v1/accounts/:id/whatsapp/groups
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Groups this business number created. Read live from the customer WhatsApp Business Account; answers 503 while WhatsApp is not set up.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
