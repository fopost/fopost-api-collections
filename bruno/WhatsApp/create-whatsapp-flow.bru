meta {
  name: Create a WhatsApp flow
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/v1/accounts/:id/whatsapp/flows
  body: json
  auth: inherit
}

params:path {
  id: {{accountId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Example name",
    "categories": [
      "SIGN_UP"
    ]
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Creates a draft flow. Upload its screens separately, then publish it.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`

  **Optional fields** (not in the example body):
  - `endpoint_uri`: string (uri)
  - `clone_flow_id`: string
}
