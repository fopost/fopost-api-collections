meta {
  name: List WhatsApp message templates
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/accounts/:id/whatsapp/templates
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Every template on the account with the review status the platform assigned. Cursor paginated through `after`. Read live from the customer WhatsApp Business Account; answers 503 while WhatsApp is not set up.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
