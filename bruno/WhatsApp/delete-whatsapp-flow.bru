meta {
  name: Delete a WhatsApp flow
  type: http
  seq: 33
}

delete {
  url: {{baseUrl}}/v1/accounts/:id/whatsapp/flows/:flowId
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Deletes a draft flow. A published flow is deprecated instead.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
