meta {
  name: List blocked WhatsApp users
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/v1/accounts/:id/whatsapp/block
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  People this business number has blocked. Cursor paginated through `after`.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
