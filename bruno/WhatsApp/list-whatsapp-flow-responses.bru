meta {
  name: List WhatsApp flow answers
  type: http
  seq: 28
}

get {
  url: {{baseUrl}}/v1/accounts/:id/whatsapp/flows/responses
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  What people submitted through this account flows, newest first. An answer rides on the message it arrived as.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
