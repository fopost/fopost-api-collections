meta {
  name: Unblock WhatsApp users
  type: http
  seq: 22
}

delete {
  url: {{baseUrl}}/v1/accounts/:id/whatsapp/block
  body: json
  auth: inherit
}

params:path {
  id: {{accountId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "users": [
      "xxxxx"
    ]
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Unblocks up to 100 numbers.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
