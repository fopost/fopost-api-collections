meta {
  name: Delete a WhatsApp group
  type: http
  seq: 16
}

delete {
  url: {{baseUrl}}/v1/accounts/:id/whatsapp/groups/:groupId
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Removes the group.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
