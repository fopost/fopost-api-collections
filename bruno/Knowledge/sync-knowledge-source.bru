meta {
  name: Re-index a knowledge source
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/knowledge/sources/:id/sync
  body: json
  auth: inherit
}

params:path {
  id: {{id}}
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([202]);
  });
}

docs {
  Queues the source to be read and indexed again — a `url` source is re-fetched. Answers 202 immediately; poll the source for its status.

  Requires the `inbox` scope when using an API key.

  **Scope:** `inbox`
}
