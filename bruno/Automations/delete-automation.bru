meta {
  name: Delete an automation
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/v1/automations/:id
  body: none
  auth: inherit
}

params:path {
  id: {{automationId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Requires the `automations` scope when using an API key.

  Requires an active subscription; without one the request fails with 403 `subscription_required`.

  **Scope:** `automations`
}
