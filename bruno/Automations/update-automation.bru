meta {
  name: Update an automation
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/v1/automations/:id
  body: json
  auth: inherit
}

params:path {
  id: {{automationId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Example name",
    "description": "Hello from FoPost.",
    "triggerType": "content_created",
    "active": false
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  When `graph` or `steps` is provided the whole graph is replaced.

  Requires the `automations` scope when using an API key.

  Requires an active subscription; without one the request fails with 403 `subscription_required`.

  **Scope:** `automations`

  **Optional fields** (not in the example body):
  - `name`: string
  - `description`: string | null
  - `triggerType`: `content_created` | `cross_post` | `rss_feed` | `api_webhook` | `schedule` | `competitor_post` | `post_outperformed` | `inbox_topic` | `inbox_message` | `radar_mention`
  - `triggerConfig`: object
  - `steps`: object[]
  - `graph`: object — The canvas: every node including exactly one trigger, and the edges between them. Output handles: `out` on plain nodes, `success`/`error` on webhook, ai and send_message, `reply`/`timeout` on wait_for_reply, `a`/`b` on ab_split, `r0..rN`/`else` on condition.
  - `active`: boolean
}
