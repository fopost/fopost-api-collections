meta {
  name: List automations
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/automations
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() < 300) {
    const body = res.getBody();
    const id = body.id || (body.data && (body.data.id || (body.data[0] && body.data[0].id)));
    if (id) bru.setVar('automationId', id);
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Requires the `automations` scope when using an API key.

  **Scope:** `automations`
}
