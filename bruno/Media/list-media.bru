meta {
  name: List media library items
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/media
  body: none
  auth: inherit
}

params:query {
  ~workspace_id: 
  ~folder_id: 
  ~search: 
  ~tag: 
  ~type: image
  ~url: 
  ~brand_role: logo
  ~brand_voice_id: 
  ~generation_run_id: 
  ~origin: 
  ~shared: true
  ~page: 1
  ~per_page: 60
}

script:post-response {
  if (res.getStatus() < 300) {
    const body = res.getBody();
    const id = body.id || (body.data && (body.data.id || (body.data[0] && body.data[0].id)));
    if (id) bru.setVar('mediaId', id);
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Newest first. Without `workspace_id` the list spans every workspace the caller belongs to.

  Requires the `posts` scope when using an API key.

  **Scope:** `posts`
}
