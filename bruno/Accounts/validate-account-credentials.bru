meta {
  name: Validate account credentials
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/accounts/:id/validate
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Checks the stored credentials against the platform and updates the health status.

  Requires the `accounts` scope when using an API key.

  Requires an active subscription; without one the request fails with 403 `subscription_required`.

  **Scope:** `accounts`
}
