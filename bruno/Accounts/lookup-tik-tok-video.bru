meta {
  name: Resolve a TikTok video for repurposing
  type: http
  seq: 54
}

post {
  url: {{baseUrl}}/v1/accounts/:id/tiktok/video-download
  body: json
  auth: inherit
}

params:path {
  id: {{accountId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "url": "https://example.com"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Resolves a share link to one of the connected account's own videos and hands back the address a repurpose run reads. A link to someone else's video answers 404.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
