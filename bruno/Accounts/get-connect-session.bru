meta {
  name: Get a hosted connect link
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/connect-sessions/:id
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Poll to learn the outcome: `status` moves from `pending` to `used` and `accountId` is set once the end user has connected. Sessions in other workspaces answer 404.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
