meta {
  name: Give a member a role
  type: http
  seq: 50
}

put {
  url: {{baseUrl}}/v1/accounts/:id/discord/roles/:roleId/members/:memberId
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
  roleId: {{roleId}}
  memberId: {{memberId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
