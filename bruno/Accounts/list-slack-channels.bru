meta {
  name: List Slack channels
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/v1/accounts/:id/slack/channels
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Channels the Slack app can post to in the connected workspace: every public channel, and private ones the app was invited to.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
