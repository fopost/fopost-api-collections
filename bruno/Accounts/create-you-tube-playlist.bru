meta {
  name: Create a YouTube playlist
  type: http
  seq: 39
}

post {
  url: {{baseUrl}}/v1/accounts/:id/youtube/playlists
  body: json
  auth: inherit
}

params:path {
  id: {{accountId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "x"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`

  **Optional fields** (not in the example body):
  - `description`: string
  - `privacy`: `public` | `unlisted` | `private`
}
