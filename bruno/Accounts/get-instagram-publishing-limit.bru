meta {
  name: Read the publishing limit
  type: http
  seq: 48
}

get {
  url: {{baseUrl}}/v1/accounts/:id/instagram/publishing-limit
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  How many posts this account has published in the rolling window, and how many are left before Instagram refuses the next one.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
