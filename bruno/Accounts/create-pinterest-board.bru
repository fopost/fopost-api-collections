meta {
  name: Create a Pinterest board
  type: http
  seq: 37
}

post {
  url: {{baseUrl}}/v1/accounts/:id/pinterest/boards
  body: json
  auth: inherit
}

params:path {
  id: {{accountId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Example name"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Creates a board on the connected account. Pass its id as the `board_id` platform setting to pin to it.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`

  **Optional fields** (not in the example body):
  - `description`: string
  - `privacy`: `PUBLIC` | `PROTECTED` | `SECRET`
}
