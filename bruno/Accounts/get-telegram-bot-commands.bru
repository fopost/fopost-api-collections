meta {
  name: List Telegram bot commands
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/accounts/:id/telegram/commands
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  The command menu the bot shows in this chat. Commands are scoped to the connected chat; channels, and chats not connected with a code, answer 400.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
