meta {
  name: Create an account group
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/v1/account-groups
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspace_id": "{{workspaceId}}",
    "name": "Example name"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`

  **Optional fields** (not in the example body):
  - `account_ids`: string (uuid)[]
}
