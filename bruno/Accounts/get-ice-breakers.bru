meta {
  name: Get ice breakers
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/v1/accounts/:id/messaging/ice-breakers
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  The tappable prompts a new Messenger or Instagram conversation opens with. Up to four; networks without them answer 400.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
