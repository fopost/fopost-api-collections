meta {
  name: Get the persistent menu
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/v1/accounts/:id/messaging/persistent-menu
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  The always-visible Messenger menu. Facebook Pages only; other networks answer 400.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
