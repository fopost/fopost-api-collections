meta {
  name: Get the greeting
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/v1/accounts/:id/messaging/greeting
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  The text shown before a Messenger conversation starts. Facebook Pages only; other networks answer 400.

  Requires the `accounts` scope when using an API key.

  **Scope:** `accounts`
}
