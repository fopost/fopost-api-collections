meta {
  name: Start a video edit
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/video-edits
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "media_id": "00000000-0000-0000-0000-000000000000",
    "operations": [
      {
        "op": "trim"
      }
    ]
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Queues the operations on a video; poll the job for the result.

  Requires the `posts` scope when using an API key.

  **Scope:** `posts`

  **Optional fields** (not in the example body):
  - `workspace_id`: string (uuid)
}
