meta {
  name: Create an A/B study
  type: http
  seq: 77
}

post {
  url: {{baseUrl}}/v1/ads/account/studies
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "adAccountId": "string",
    "name": "Example name",
    "startAt": "2026-01-01T12:00:00.000Z",
    "endAt": "2026-01-01T12:00:00.000Z",
    "cells": [
      {
        "name": "Example name",
        "objectIds": [
          "x"
        ]
      }
    ]
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Splits traffic evenly across the cells for the length of the flight.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`

  **Optional fields** (not in the example body):
  - `description`: string
}
