meta {
  name: List the ad account's activity log
  type: http
  seq: 70
}

get {
  url: {{baseUrl}}/v1/ads/account/activity?connection_id=&ad_account_id=
  body: none
  auth: inherit
}

params:query {
  ~workspace_id: 
  connection_id: 
  ad_account_id: 
  ~since: 
  ~until: 
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Every change Meta recorded on the ad account, read live and never stored.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`
}
