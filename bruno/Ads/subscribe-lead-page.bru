meta {
  name: Collect a Page’s leads
  type: http
  seq: 95
}

post {
  url: {{baseUrl}}/v1/ads/lead-pages
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "pageId": "string"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Turns on new-lead notifications for the Page and backfills its most recent leads into the feed.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`
}
