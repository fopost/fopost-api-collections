meta {
  name: Create a custom audience
  type: http
  seq: 88
}

post {
  url: {{baseUrl}}/v1/ads/audiences
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "adAccountId": "string",
    "name": "Example name",
    "spec": {
      "subtype": "CUSTOM"
    }
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  A customer list (`CUSTOM`, emails are hashed before they leave), a lookalike of an existing audience (`LOOKALIKE`), or website visitors from a pixel (`WEBSITE`).

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`

  **Optional fields** (not in the example body):
  - `description`: string
}
