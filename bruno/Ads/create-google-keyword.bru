meta {
  name: Add a keyword
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/v1/ads/google/keywords
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "customerId": "string",
    "adGroupId": "string",
    "text": "Hello from FoPost.",
    "matchType": "EXACT"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Adds a keyword to an ad group. Needs the `publish` scope: it goes live.

  Requires the `publish` scope when using an API key.

  **Scope:** `publish`

  **Optional fields** (not in the example body):
  - `cpcBidMinor`: integer — Bid in account minor units
}
