meta {
  name: Create a creative
  type: http
  seq: 41
}

post {
  url: {{baseUrl}}/v1/ads/creatives
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "adAccountId": "x",
    "pageId": "x",
    "name": "Example name",
    "format": "image",
    "text": "Hello from FoPost."
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  An image, video or carousel creative from library media. Nothing runs until an ad uses it.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`

  **Optional fields** (not in the example body):
  - `headline`: string
  - `destinationUrl`: string (uri)
  - `callToAction`: `LEARN_MORE` | `SHOP_NOW` | `SIGN_UP` | `SUBSCRIBE` | `CONTACT_US` | `DOWNLOAD` | `GET_OFFER` | `BOOK_NOW` | `APPLY_NOW` | `WATCH_MORE` — Defaults to `LEARN_MORE`
  - `urlTags`: string — Query string appended to every link in the ad, e.g. `utm_source=meta&utm_medium=paid`
  - `mediaUrl`: string — A media library asset url: the image, or the video. Required for `video`
  - `thumbnailMediaUrl`: string — A video's poster frame, as a library image; Meta's own frame when omitted
  - `cards`: object[] — Carousel cards; required for `carousel`
}
