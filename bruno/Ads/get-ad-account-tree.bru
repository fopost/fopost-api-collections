meta {
  name: Get an ad account’s campaign tree
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/v1/ads/accounts/:adAccountId/tree?connection_id=
  body: none
  auth: inherit
}

params:query {
  ~workspace_id: 
  connection_id: 
}

params:path {
  adAccountId: {{adAccountId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Every campaign on the ad account with its ad sets and ads, whoever made them. Read live from Meta and never stored.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`
}
