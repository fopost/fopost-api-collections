meta {
  name: Dismiss recommendations
  type: http
  seq: 40
}

post {
  url: {{baseUrl}}/v1/ads/google/recommendations/dismiss
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "customerId": "string"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Hides each recommendation so Google stops surfacing it.

  Requires the `publish` scope when using an API key.

  **Scope:** `publish`
}
