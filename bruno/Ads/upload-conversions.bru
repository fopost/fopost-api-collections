meta {
  name: Upload offline conversions
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/v1/ads/conversions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "adAccountId": "string",
    "pixelId": "x",
    "events": [
      {
        "eventName": "Example event",
        "occurredAt": "string"
      }
    ]
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([202]);
  });
}

docs {
  Events that happened away from the site, attributed to a pixel the ad account owns. Emails and phone numbers are hashed before anything leaves FoPost.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`
}
