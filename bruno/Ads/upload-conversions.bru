meta {
  name: Send conversions to a pixel
  type: http
  seq: 104
}

post {
  url: {{baseUrl}}/v1/ads/conversions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "adAccountId": "x",
    "pixelId": "x",
    "events": [
      {
        "eventName": "Example event",
        "occurredAt": "string"
      }
    ]
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([202]);
  });
}

docs {
  The network's Conversions API, on every network that declares `conversions` and takes pixel events. Email, phone and external id are hashed before anything leaves FoPost and only the hashes are kept. An `Idempotency-Key` header, when sent, makes a repeat of the same key in the same workspace answer the first outcome without reaching the network; `POST /v1/ads/conversions/events` is the same route with the header required.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`
}
