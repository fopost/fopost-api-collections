meta {
  name: Create a campaign
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/v1/ads/campaigns
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "adAccountId": "string",
    "name": "Example name",
    "goal": "engagement"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Starts paused unless `paused` is false. Also requires the `publish` scope.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`

  **Optional fields** (not in the example body):
  - `paused`: boolean — Create it paused; set to false to go live at once
  - `smartPlus`: boolean — Hands targeting and creative rotation to the network. Only on a network whose `capabilities.smartPlus` is true; 400 otherwise.
}
