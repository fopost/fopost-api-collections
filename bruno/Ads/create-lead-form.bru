meta {
  name: Create an Instant Form
  type: http
  seq: 48
}

post {
  url: {{baseUrl}}/v1/ads/lead-forms
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "pageId": "string",
    "name": "Example name",
    "questions": [
      "EMAIL"
    ],
    "privacyPolicyUrl": "https://example.com",
    "thankYouMessage": "Hello from FoPost."
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Requires the `ads` scope when using an API key.

  **Scope:** `ads`

  **Optional fields** (not in the example body):
  - `followUpUrl`: string (uri)
}
