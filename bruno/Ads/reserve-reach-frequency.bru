meta {
  name: Reserve a prediction
  type: http
  seq: 64
}

post {
  url: {{baseUrl}}/v1/ads/reach-frequency/:id/reserve
  body: json
  auth: inherit
}

params:path {
  id: {{id}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "adAccountId": "string"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Holds the inventory the prediction priced. Spends on the ad account.

  Requires the `ads` and `publish` scopes when using an API key.

  **Scope:** `ads`
}
