}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([204]);
  });
}

docs {
  The network keeps the history, so the rule stops counting rather than going away.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`
}
