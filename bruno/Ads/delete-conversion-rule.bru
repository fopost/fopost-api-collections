meta {
  name: Turn a conversion rule off
  type: http
  seq: 56
}

delete {
  url: {{baseUrl}}/v1/ads/linkedin/conversion-rules/:id?workspace_id=&connection_id=
  body: none
  auth: inherit
}

params:query {
  workspace_id: 
  connection_id: 
}

