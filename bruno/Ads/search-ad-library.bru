  ~limit: 
  ~after: 
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Ads anyone is running, by keyword or by Page. Read live from Meta on every request and never stored, so a result that stops running is simply absent next time.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`
}
