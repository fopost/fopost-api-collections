meta {
  name: Create a value rule set
  type: http
  seq: 85
}

post {
  url: {{baseUrl}}/v1/ads/account/value-rule-sets
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "adAccountId": "string",
    "name": "Example name",
    "rules": [
      {
        "condition": "x",
        "multiplier": 1
      }
    ]
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Weights conversions so some audiences count for more than others.

  Requires the `ads` and `publish` scopes when using an API key.

  **Scope:** `ads`
}
