meta {
  name: Create an ad
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/ads
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "adAccountId": "x",
    "name": "Example name",
    "goal": "engagement",
    "budget": {
      "minor": 1,
      "type": "daily"
    },
    "targeting": {
      "countries": [
        "xx"
      ],
      "ageMin": 13,
      "ageMax": 13,
      "gender": "all"
    }
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Creates a campaign, ad set and ad on the Meta ad account from the given creative. The ad starts paused unless `paused` is false. Also requires the `publish` scope.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`

  **Optional fields** (not in the example body):
  - `conversionTagId`: string — The `website_sales` and `website_leads` goals: the ad account’s conversion tag, from `GET /v1/ads/pixels`. May be left out when the account has exactly one
  - `conversionEvent`: `checkout` | `add_to_cart` | `initiate_checkout` | `add_payment_info` | `add_to_wishlist` | `customize_product` | `signup` | `subscribe` | `submit_application` | `start_trial` | `lead` | `schedule` | `contact` | `find_location` — Required by `website_sales` (checkout, add_to_cart, initiate_checkout, add_payment_info, add_to_wishlist, customize_product) and `website_leads` (signup, subscribe, submit_application, start_trial, lead, schedule, contact, find_location): the site event the ad is judged on
  - `paused`: boolean — Create the ad paused; set to false to go live at once
  - `pageId`: string — The Page the ad runs as; only networks with `usesPages` need one
  - `text`: string — Required unless `sparkPostId` is set, which carries the post’s own caption
  - `sparkPostId`: string — A post already live on the network, from `GET /v1/ads/spark-posts`. Runs it as a Spark ad, so `text` and `mediaUrl` are ignored. Needs `capabilities.sparkAds`.
  - `headline`: string
  - `destinationUrl`: string (uri)
  - `mediaUrl`: string — A media library asset url
  - `urlTags`: string — Query string appended to every link in the ad, e.g. `utm_source=meta&utm_medium=paid`
  - `messagingDestination`: `messenger` | `instagram_direct` | `whatsapp` — Required by the `messages` goal. `whatsapp` is refused unless the deployment has a WhatsApp business number
  - `phoneNumber`: string — Required by the `calls` goal, in E.164, e.g. `+14155550123`
  - `productSetId`: string — Required by the `sales` goal: makes this a catalog ad over that product set
}
