meta {
  name: Create an ad
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/ads
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "connectionId": "00000000-0000-0000-0000-000000000000",
    "adAccountId": "string",
    "name": "Example name",
    "goal": "engagement",
    "budget": {
      "minor": 1,
      "type": "daily"
    },
    "targeting": {
      "countries": [
        "xx"
      ],
      "ageMin": 13,
      "ageMax": 13,
      "gender": "all"
    },
    "pageId": "string"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Creates a campaign, ad set and ad on the Meta ad account from the given creative. The ad starts paused unless `paused` is false. Also requires the `publish` scope.

  Requires the `ads` scope when using an API key.

  **Scope:** `ads`

  **Optional fields** (not in the example body):
  - `paused`: boolean — Create the ad paused; set to false to go live at once
  - `text`: string — Required unless `sparkPostId` is set, which carries the post’s own caption
  - `sparkPostId`: string — A post already live on the network, from `GET /v1/ads/spark-posts`. Runs it as a Spark ad, so `text` and `mediaUrl` are ignored. Needs `capabilities.sparkAds`.
  - `headline`: string
  - `destinationUrl`: string (uri)
  - `mediaUrl`: string — A media library asset url
  - `urlTags`: string — Query string appended to every link in the ad, e.g. `utm_source=meta&utm_medium=paid`
}
