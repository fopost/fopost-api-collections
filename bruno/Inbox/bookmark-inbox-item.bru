meta {
  name: Bookmark an item
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/v1/inbox/:id/bookmark
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Save privately to the account's bookmarks (X). Only where `can_bookmark` is true. Also requires the `publish` scope.

  Requires the `inbox` scope when using an API key.

  **Scope:** `inbox`
}
