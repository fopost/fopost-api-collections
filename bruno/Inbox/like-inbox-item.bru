meta {
  name: Like an item
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/v1/inbox/:id/like
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  A like, an upvote on Reddit, a favourite on Mastodon. Only where `canLike` is true. Also requires the `publish` scope.

  Requires the `inbox` scope when using an API key.

  **Scope:** `inbox`
}
