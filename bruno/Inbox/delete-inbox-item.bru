meta {
  name: Delete a comment on the platform
  type: http
  seq: 14
}

delete {
  url: {{baseUrl}}/v1/inbox/:id
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Removes the comment from the platform where it was left, whether someone else wrote it or it is our own reply. Only where `canDelete` is true. Deleting our own reply also requires the `publish` scope.

  Requires the `inbox` scope when using an API key.

  **Scope:** `inbox`
}
