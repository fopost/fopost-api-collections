meta {
  name: Delete a conversation from the inbox
  type: http
  seq: 27
}

delete {
  url: {{baseUrl}}/v1/inbox/conversations/:id?account_id=
  body: none
  auth: inherit
}

params:query {
  account_id: 
}

params:path {
  id: {{id}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([204]);
  });
}

docs {
  Removes a DM thread from the inbox only. No network lets an app delete a conversation, so the platform keeps its copy and the thread returns if the other side writes again.

  Requires the `inbox` scope when using an API key.

  **Scope:** `inbox`
}
