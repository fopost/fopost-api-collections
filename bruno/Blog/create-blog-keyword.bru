meta {
  name: Add a keyword
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/blog/keywords
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}",
    "keyword": "string"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Requires the `posts` scope when using an API key.

  **Scope:** `posts`

  **Optional fields** (not in the example body):
  - `plannedFor`: string (date)
}
