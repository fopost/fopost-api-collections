meta {
  name: Research keywords
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/blog/keywords/plan
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([202]);
  });
}

docs {
  Researches the approved search terms in the background and spends AI credits. Results land as `suggested` keywords; set one to `planned` to put it on the calendar. Seeds are derived from the blog settings when omitted. Follow the run in `plan_run` on the settings.

  Requires the `ai` scope when using an API key.

  **Scope:** `ai`

  **Optional fields** (not in the example body):
  - `seeds`: string[]
}
