meta {
  name: Update a keyword
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/v1/blog/keywords/:id?workspaceId=
  body: json
  auth: inherit
}

params:query {
  workspaceId: 
}

params:path {
  id: {{id}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "status": "suggested",
    "plannedFor": "2026-01-01"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Requires the `posts` scope when using an API key.

  **Scope:** `posts`

  **Optional fields** (not in the example body):
  - `status`: `suggested` | `planned` | `written` | `dismissed`
  - `plannedFor`: string (date) | null
}
