meta {
  name: Rotate the website signing secret
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/blog/settings/website-secret
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspaceId": "{{workspaceId}}"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  The new secret is returned once and never readable again.

  Requires the `posts` scope when using an API key.

  **Scope:** `posts`
}
