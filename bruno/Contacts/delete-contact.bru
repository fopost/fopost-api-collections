meta {
  name: Delete a contact
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/v1/contacts/:id
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Removes the contact and its field values. The messages they sent stay in the inbox, and a later message files them again. This cannot be undone.

  Requires the `inbox` scope when using an API key.

  **Scope:** `inbox`
}
