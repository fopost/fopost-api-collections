meta {
  name: Create a design from a post
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/designs/from-post
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspace_id": "{{workspaceId}}"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Requires the `posts` scope when using an API key.

  **Scope:** `posts`

  **Optional fields** (not in the example body):
  - `text`: string
  - `post_id`: string
  - `style`: `quote` | `post` | `plain`
  - `preset`: string
  - `account_id`: string
  - `carousel`: boolean
  - `name`: string
  - `brand_voice_id`: string (uuid) | null
}
