meta {
  name: Comment through a review link
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/v1/design-review/:token/comments
  body: json
  auth: inherit
}

params:path {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Example name",
    "body": "x"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Public: the guest writes under the name they give.

  **Optional fields** (not in the example body):
  - `page_index`: integer
  - `x`: number | null
  - `y`: number | null
  - `parent_id`: string (uuid) | null — Reply to this comment
}
