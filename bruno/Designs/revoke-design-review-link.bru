meta {
  name: Revoke a review link
  type: http
  seq: 22
}

delete {
  url: {{baseUrl}}/v1/designs/:id/review-links/:linkId
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
  linkId: {{linkId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Requires the `posts` scope when using an API key.

  **Scope:** `posts`
}
