meta {
  name: Read one article
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/accounts/:id/blogs/:blogId/articles/:articleId
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
  blogId: {{blogId}}
  articleId: {{articleId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Requires the `posts` scope when using an API key.

  **Scope:** `posts`
}
