meta {
  name: Delete an article
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/v1/accounts/:id/blogs/:blogId/articles/:articleId
  body: none
  auth: inherit
}

params:path {
  id: {{accountId}}
  blogId: {{blogId}}
  articleId: {{articleId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([204]);
  });
}

docs {
  Removes the article from the connected site. This cannot be undone.

  Requires the `publish` scope when using an API key.

  **Scope:** `publish`
}
