meta {
  name: Delete a sequence
  type: http
  seq: 13
}

delete {
  url: {{baseUrl}}/v1/sequences/:id
  body: none
  auth: inherit
}

params:path {
  id: {{id}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Removes the sequence and every enrollment on it. Messages already sent stay in the conversations they went to. This cannot be undone.

  Requires the `inbox` scope when using an API key.

  **Scope:** `inbox`
}
