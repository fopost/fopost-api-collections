meta {
  name: Add a posting slot
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/queue/slots
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workspace_id": "{{workspaceId}}",
    "weekday": 0,
    "time": "string",
    "timezone": "UTC"
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([201]);
  });
}

docs {
  Adds a weekly slot. Omit `account_id` for a slot every account in the workspace shares.

  Requires the `posts` scope when using an API key.

  **Scope:** `posts`

  **Optional fields** (not in the example body):
  - `account_id`: string (uuid) | null
}
