meta {
  name: List posts
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/posts
  body: none
  auth: inherit
}

params:query {
  ~page: 1
  ~per_page: 30
  ~workspace_id: 
  ~status: draft
  ~search: 
  ~platform: 
  ~label: 
  ~account_id: 
  ~date: 
  ~from: 
  ~to: 
  ~sort: oldest
}

script:post-response {
  if (res.getStatus() < 300) {
    const body = res.getBody();
    const id = body.id || (body.data && (body.data.id || (body.data[0] && body.data[0].id)));
    if (id) bru.setVar('postId', id);
  }
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Lists posts across all workspaces the user belongs to, newest first. All filters are optional and combine with AND semantics.

  Requires the `posts` scope when using an API key.

  **Scope:** `posts`
}
