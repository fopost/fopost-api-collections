meta {
  name: Delete a label
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/v1/labels/:id
  body: none
  auth: inherit
}

params:path {
  id: {{labelId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([200]);
  });
}

docs {
  Requires the `labels` scope when using an API key.

  Requires an active subscription; without one the request fails with 403 `subscription_required`.

  **Scope:** `labels`
}
