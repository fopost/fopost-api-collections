meta {
  name: Delete a workspace
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/v1/workspaces/:id
  body: none
  auth: inherit
}

params:path {
  id: {{workspaceId}}
}

tests {
  test('status is successful', function () {
    expect(res.getStatus()).to.be.oneOf([204]);
  });
}

docs {
  Soft-deletes the workspace. Requires the workspace owner role. Refused with 409 while accounts are still connected, or when it is your only workspace.

  Requires the `workspaces` scope when using an API key.

  Requires an active subscription; without one the request fails with 403 `subscription_required`.

  **Scope:** `workspaces`
}
